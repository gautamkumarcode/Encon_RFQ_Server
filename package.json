{
  "name": "encon-command-center-backend",
  "version": "1.0.0",
  "description": "Backend API service for Encon Command Center",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "render-postinstall": "tsc",
    "start": "npm run build && node dist/server.js",
    "dev": "npx ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "reset-db-keep-admin": "ts-node src/utils/resetDbKeepAdmin.ts",
    "clear-rfq-data": "ts-node src/utils/clearRfqData.ts",
    "sync-matched-rfqs": "node scripts/sync_matched_rfqs.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.19",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "ts-node-dev": "^2.0.0"
  }
}
